    layout {
        gaps 24 // Gap between windows

        always-center-single-column
        center-focused-column "on-overflow"

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        focus-ring {
            width 2
        }

        shadow {
            on
        }

        struts {}
    }
